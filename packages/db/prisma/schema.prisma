// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Interest {
  TikTok
  Video_Gaming
  Travel
  Gardening
  Sports
  Outdor_Activity
  Arts_and_crafts
  Cooking
  Reading
  Running
  Technology
  Other
}

enum Professions {
  Teacher
  Doctor
  Lawyer
  Engineer
  Software_Developer
  Chief
  Accountant
  Art_Director
  Dentist
  Designer
  Film_Maker
  Photographer
  Farmer
  Other
}

model User {
  id         String       @id @unique @default(uuid())
  name       String
  email      String       @unique
  image      String
  interests  Interest[]   @map("Other")
  aboutMe    String?
  createdAt  DateTime     @default(now())
  profession Professions?
}
